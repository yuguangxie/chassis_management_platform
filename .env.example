CHASSIS_BACKEND_HOST=127.0.0.1
CHASSIS_BACKEND_PORT=8800
CHASSIS_RUNTIME_PROFILE=dev
# Packaged desktop defaults to mock when this variable is absent. Set production
# only through an approved local launcher together with signed configuration inputs.
# CHASSIS_DESKTOP_RUNTIME_PROFILE=mock
CHASSIS_SESSION_TTL_SECONDS=900
CHASSIS_AUTH_MAX_FAILED_ATTEMPTS=5
CHASSIS_AUTH_LOCKOUT_SECONDS=300
CHASSIS_MIN_FREE_BYTES=104857600
CHASSIS_PRINT_BACKEND=virtual
CHASSIS_ALLOWED_UI_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE=http://127.0.0.1:8800/api/v1
VITE_WS_URL=ws://127.0.0.1:8800/ws
# Keep runtime data and generated bootstrap material outside source-controlled paths in production.
# CHASSIS_DATA_DIR=C:\ProgramData\ChassisEOL
# CHASSIS_CONFIG_DIR=C:\ProgramData\ChassisEOL\config-source
# CHASSIS_ASSETS_DIR=C:\ProgramData\ChassisEOL\assets
# CHASSIS_ACTIVE_CONFIG_PATH=C:\ProgramData\ChassisEOL\config\active-package.json
# CHASSIS_REPORT_FONT=C:\Windows\Fonts\msyh.ttc
# CHASSIS_ALLOWED_FILE_ROOT=C:\ProgramData\ChassisEOL
# Optional one-process bootstrap alternative; generate a new value locally and never commit it.
# CHASSIS_BOOTSTRAP_SECRET=
# Required for signed configuration import/export; inject from the local secret store.
# CHASSIS_CONFIG_SIGNING_KEY=
# CHASSIS_SIDECAR_TOKEN is intentionally absent: Electron generates it per start.
# Production normally uses CHASSIS_PRINT_BACKEND=windows and must package pywin32.
